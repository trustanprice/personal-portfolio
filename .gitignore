# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# LaTeX build artifacts (resume/) — pdflatex always names output after the
# input file, so resume.tex always produces resume.pdf; that's a transient
# intermediate, gitignored like the rest. The intentionally-named copies
# (trustanprice-resume.pdf, public/home/trustanprice-cv2026.pdf) are committed.
resume/*.aux
resume/*.log
resume/*.out
resume/*.fls
resume/*.fdb_latexmk
resume/*.synctex.gz
resume/resume.pdf
resume/resume_preview*.png
resume/preview*.png

# Job-tailored resume variants (resume/AGENTS.md) — working files for one
# application, not portfolio content, unless explicitly committed.
# Naming is trustanprice-<company>.tex/.pdf; the base resume's compiled
# output (trustanprice-resume.pdf) is the one exception, kept tracked.
resume/trustanprice-*.tex
resume/trustanprice-*.pdf
!resume/trustanprice-resume.pdf
